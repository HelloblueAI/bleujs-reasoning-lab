# Local development secrets for Cloudflare Workers (wrangler dev).
# Copy to .dev.vars and fill in real values. Never commit .dev.vars.
#
#   cp .dev.vars.example .dev.vars
#
# Deployed instances: use `wrangler secret put <NAME>` instead of this file.

# Provider keys for POST /reason. All optional; with none set, only local
# arithmetic is answered. BLEUJS_API_KEY is tried first when present.
BLEUJS_API_KEY=
# BLEUJS_CHAT_URL=https://<your-bleujs-endpoint>/api/v1/chat
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
# NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Set to "true" to try the other configured providers when the first one fails.
ALLOW_LLM_FALLBACK=false

# Bearer token for GET /metrics (operational counters). Unset = /metrics returns 404.
# METRICS_TOKEN=

# Reasoning Lab evaluation only (pnpm run eval:model). Never read by the Worker,
# so an eval model can never be served by /reason. Use a separate key.
NVIDIA_EVAL_API_KEY=
# NVIDIA_EVAL_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_EVAL_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
