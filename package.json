{
  "name": "bleujs-reasoning-lab",
  "version": "1.0.0",
  "description": "Open-source TypeScript laboratory for evaluating LLM reasoning, provider routing, retrieval, tool selection, and agent orchestration",
  "main": "src/worker/index.ts",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:unit": "vitest tests/unit",
    "test:eval": "vitest tests/eval --run",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest --run --reporter=verbose",
    "eval": "tsx src/evals/cli.ts",
    "eval:model": "tsx src/evals/modelCli.ts",
    "lint": "eslint src tests --ext .ts --max-warnings 0",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test:unit -- --run && pnpm run test:eval",
    "worker:dev": "wrangler dev --config wrangler.toml",
    "worker:types": "wrangler types --config wrangler.toml",
    "deploy:worker": "wrangler deploy --config wrangler.toml",
    "deploy:worker:prod": "wrangler deploy --config wrangler.toml --env production",
    "deploy:worker:dry-run": "wrangler deploy --config wrangler.toml --env production --dry-run",
    "deploy:worker:staging": "wrangler deploy --config wrangler.toml --env staging",
    "worker:tail": "wrangler tail --config wrangler.toml"
  },
  "keywords": [
    "bleujs",
    "reasoning",
    "evals",
    "cloudflare-workers",
    "llm-routing",
    "retrieval",
    "agent-orchestration"
  ],
  "author": "BleuJS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HelloblueAI/bleujs-reasoning-lab.git"
  },
  "homepage": "https://agi.bleujs.org",
  "bugs": {
    "url": "https://github.com/HelloblueAI/bleujs-reasoning-lab/issues"
  },
  "packageManager": "pnpm@10.8.1",
  "dependencies": {
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.124.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "js-yaml": "^4.3.2",
      "minimatch@9": "9.0.7"
    }
  }
}
